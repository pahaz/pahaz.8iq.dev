---
import { PROJECTS } from "@/constants";
---

{
  PROJECTS.length > 0 && (
    <>
      <hr class="mt-6 border-border" aria-hidden="true" />
      <ul
        aria-label="Projects"
        class="scrollbar-none -mx-4 mt-6 flex snap-x snap-mandatory gap-3 overflow-x-auto px-4 pb-1"
      >
        {PROJECTS.map(project => (
          <li class="shrink-0 snap-start">
            <a
              href={project.href}
              class="flex size-24 flex-col items-center justify-center gap-2 rounded-lg border border-border p-2 hover:border-accent hover:text-accent"
            >
              <project.icon aria-hidden="true" class="size-10" />
              <span class="text-xs font-medium">{project.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </>
  )
}

<style>
  .scrollbar-none {
    scrollbar-width: none;
  }
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
</style>
